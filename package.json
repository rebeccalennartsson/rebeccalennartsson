{
  "name": "rebeccalennartsson",
  "homepage": "https://rebeccalennartsson.se",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir build-ssr && node scripts/prerender.js",
    "preview": "vite preview",
    "predeploy": "yarn build",
    "deploy": "find build -name .DS_Store -delete && gh-pages -d build --dotfiles"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "gh-pages": "6.3.0",
    "sass": "1.108.2",
    "vite": "8.3.8"
  }
}
